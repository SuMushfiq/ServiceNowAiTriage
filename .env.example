# ServiceNow PDI
SNOW_INSTANCE=https://your-instance.service-now.com
SNOW_USERNAME=admin
SNOW_PASSWORD=your-password

# Gemini, via its OpenAI-compatible endpoint (classifier.py). Pin a specific
# model rather than a -latest alias: the aliases move to newer models that
# can carry much tighter free-tier quotas.
GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# VirusTotal (vt_client.py) - free key from virustotal.com under your profile
VIRUSTOTAL_API_KEY=your-api-key
